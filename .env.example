# Canonical site URL used in metadata, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://advisoraisolutions.io

# Optional. When set, contact and assessment forms POST JSON here
# (HTTPS only). When unset, the form opens a mailto to
# jordan@advisoraisolutions.com so the submission is not dropped.
# CONTACT_FORM_ENDPOINT=https://example.com/hooks/aais
